# AetherNet — Variables de entorno de ejemplo
# Copia este archivo como `.env` y completa con tus propios valores.
# Nunca subas el `.env` real al repositorio (debe estar en .gitignore).
# Referencia: docs/backlog.md (DEVOPS-08), docs/requirements.md (RNF-1.1)

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=aethernet
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aethernet
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── FastAPI (backend/) ───────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Usada para firmar tokens/sesiones si aplica — genera una propia, no reutilices esta
SECRET_KEY=changeme
# Cadena de conexión construida a partir de las variables de Postgres de arriba
DATABASE_URL=postgresql://aethernet:changeme@db:5432/aethernet

# ── Mosquitto MQTT ────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=aethernet
MQTT_PASSWORD=changeme

# ── Node-RED / Telegram Bot (automation/) ────────────────────
# Obtén el token creando el bot vía BotFather (ver docs/roadmap.md, sección 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Tuya Local — bombillo Mercury LB401 (automation/) ────────
# Obtén device_id y local_key con `tinytuya wizard` (ver riesgo LOW-01 en docs/backlog.md)
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_DEVICE_IP=
