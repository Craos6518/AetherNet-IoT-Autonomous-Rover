automation/.node-red/settings.js # settings con credenciales — como `settings.js` en Node-RED (contiene `credentialSecret`)
automation/.node-red/flows*.json # flows activos — como `flows.json` en Node-RED (se versiona `automation/flows/*.json` canónico, no este)
automation/.node-red/flows*.json.backup
automation/.node-red/*.log
automation/.node-red/*.pid
automation/.node-red/lib/
automation/.node-red/projects/

