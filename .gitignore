.build/ # build arduino-cli — como `.build/` en arduino-cli
.build-*/
*.ino.cpp # preprocesado — como `*.ino` + `Arduino.h` (no se versiona)
*.ino.h
*.ino.elf
*.ino.hex
*.ino.bin
*.ino.eep
*.ino.map
*.ino.lss
*.ino.sym
*.ino.lst

