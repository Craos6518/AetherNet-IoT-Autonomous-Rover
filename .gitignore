# AetherNet IoT & Autonomous Rover - .gitignore
# Generated for multi-component project: Python/FastAPI, Android/Kotlin, C++/Arduino, Node-RED, Docker

# =============================================================================
# Python / Backend / Stats
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
*.egg-info/
dist/
build/
*.egg

# Virtual environments (if any in subdirectories)
backend/.venv/
stats/.venv/
automation/.venv/

# Environment files (keep .env.example but ignore actual .env)
.env
.env.local
.env.*.local
backend/.env
automation/.env

# =============================================================================
# Docker
# =============================================================================
.docker/
docker-compose.override.yml
*.dockerfile~

