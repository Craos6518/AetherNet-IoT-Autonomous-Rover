[
  {
    "id": "mqtt-intrusion",
    "type": "mqtt in",
    "z": "aethernet-main",
    "name": "Intrusion Event (MQTT)",
    "topic": "aethernet/seguridad/intrusion",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 100,
    "wires": [
      [
        "function-parse-intrusion"
      ]
    ]
  },
  {
    "id": "function-parse-intrusion",
    "type": "function",
    "z": "aethernet-main",
    "name": "Parse Intrusion Payload",
    "func": "// Expected payload: { sensor_id: \"laser-01\", timestamp: \"...\", location: \"entrance\" }\nconst payload = msg.payload;\nmsg.topic = \"intrusion\";\nmsg.payload = {\n    event: \"intrusion_detected\",\n    sensor: payload.sensor_id || \"unknown\",\n    location: payload.location || \"entrance\",\n    timestamp: payload.timestamp || new Date().toISOString(),\n    severity: \"high\"\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 100,
    "wires": [
      [
        "telegram-alert",
        "debug-intrusion"
      ]
    ]
  },
  {
    "id": "telegram-alert",
    "type": "function",
    "z": "aethernet-main",
    "name": "Format Telegram Message",
    "func": "const msgText = `🚨 *ALERTA DE INTRUSIÓN* 🚨\n\n` +\n    `📍 Ubicación: ${msg.payload.location}\n` +\n    `📡 Sensor: ${msg.payload.sensor}\n` +\n    `⏰ Tiempo: ${new Date(msg.payload.timestamp).toLocaleString()}\n` +\n    `⚠️ Severidad: ${msg.payload.severity.toUpperCase()}`;\n\nmsg.payload = {\n    chat_id: $globalContext(\"telegram_chat_id\"),\n    text: msgText,\n    parse_mode: \"Markdown\"\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 550,
    "y": 50,
    "wires": [
      [
        "http-telegram"
      ]
    ]
  },
  {
    "id": "http-telegram",
    "type": "http request",
    "z": "aethernet-main",
    "name": "Send to Telegram Bot API",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "https://api.telegram.org/bot$globalContext(\"telegram_bot_token\")/sendMessage",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "x": 750,
    "y": 50,
    "wires": [
      [
        "debug-telegram"
      ]
    ]
  },
  {
    "id": "debug-intrusion",
    "type": "debug",
    "z": "aethernet-main",
    "name": "Debug: Intrusion Event",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 550,
    "y": 200,
    "wires": []
  },
  {
    "id": "debug-telegram",
    "type": "debug",
    "z": "aethernet-main",
    "name": "Debug: Telegram Response",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 950,
    "y": 50,
    "wires": []
  },
  {
    "id": "mqtt-broker",
    "type": "mqtt-broker",
    "name": "Mosquitto Local",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered-aethernet",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  }
]
