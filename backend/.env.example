# Backend .env.example — DEVOPS-08 / DEVOPS-11
# Copia a backend/.env (gitignored) y ajusta valores LAN.
# No commitees .env con secretos reales.

# PostgreSQL — usado por docker-compose.yml y backend/app/config.py:7
POSTGRES_USER=aethernet
POSTGRES_PASSWORD=changeme_secure_password_here
POSTGRES_DB=aethernet
DATABASE_URL=postgresql+asyncpg://aethernet:changeme_secure_password_here@postgres:5432/aethernet

# MQTT — Mosquitto (docker-compose service "mosquitto")
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# FastAPI — opcional, sobrescribe defaults de backend/app/config.py:11
# API_HOST=0.0.0.0
# API_PORT=8000
