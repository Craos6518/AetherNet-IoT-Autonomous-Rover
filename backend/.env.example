# =============================================================================
# Backend .env.example — Plantilla env vars | 6º Semestre UTP | DEVOPS-08/11
# Autor: Est. Tecnología en Desarrollo Software + Ing. Sistemas (UTP)
# Experiencia: 1 año PostgreSQL (DATABASE_URL), 2 años JS/React (dotenv),
#              2 años Python (pydantic-settings), 2 años electrónica (secrets.h)
# Analogía React: este archivo es `.env.example` en create-react-app — plantilla
# commiteable con valores dummy. El `.env` real (gitignored) tiene secretos.
# Analogía C/Arduino: como `secrets.h.example` en gateway-esp32 — plantilla para
# que clones sepan qué vars definir sin exponer passwords reales (como FELIPE./2516f751).
# Analogía PostgreSQL: DATABASE_URL es la misma que usarías en `psql $DATABASE_URL`
# o `psql postgresql://aethernet:changeme@postgres:5432/aethernet`.
# FOSS: dotenv + pydantic-settings leen este .env (MIT) — RNF-3.1.
# Uso: cp .env.example .env && edita PASSWORD (no commitees .env) — ver .gitignore
# Origen: DEVOPS-08 (documentar env) + DEVOPS-11 (rotación secretos) + config.py:6
# =============================================================================
# .env.example — DEVOPS-08 / DEVOPS-11 — copia a backend/.env (gitignored) y ajusta valores LAN.
# No commitees .env con secretos reales — .env está en .gitignore como secrets.h en firmware.

# --------------------------------------------------------------------------
# PostgreSQL — usado por docker-compose.yml (servicio postgres) y backend/app/config.py:7
# --------------------------------------------------------------------------
# POSTGRES_* son para docker-compose.yml postgres service (init DB y user)
# DATABASE_URL es para backend/app/config.py y stats/db_extract.py (SQLAlchemy asyncpg)
# En Docker, host es "postgres" (nombre servicio), no localhost — ver docker-compose.yml
POSTGRES_USER=aethernet  # usuario DB — como DB_USER en Node .env
POSTGRES_PASSWORD=changeme_secure_password_here  # ¡cambia en .env real! — no uses changeme en prod (como default password en secrets.h)
POSTGRES_DB=aethernet  # nombre DB — como DB_NAME en Node
# DATABASE_URL con asyncpg — driver async para SQLAlchemy (config.py:7 database_url)
# Formato: postgresql+asyncpg://user:password@host:port/dbname — asyncpg es como pg-promise en Node pero async
# En local sin Docker: localhost:5432; en Docker: postgres:5432 (servicio)
DATABASE_URL=postgresql+asyncpg://aethernet:changeme_secure_password_here@postgres:5432/aethernet

# --------------------------------------------------------------------------
# MQTT — Mosquitto (docker-compose service "mosquitto") — ver mosquitto.conf:4
# --------------------------------------------------------------------------
# MQTT_BROKER_HOST — "mosquitto" en Docker (nombre servicio), "localhost" en local con Mosquitto instalado
# Mismos que en gateway-esp32 secrets.h MQTT_BROKER / config.py:8 mqtt_broker_host
MQTT_BROKER_HOST=mosquitto  # en Docker es "mosquitto", en local sin Docker sería "localhost" o "192.168.1.14" (lab)
MQTT_BROKER_PORT=1883  # 1883 MQTT, 9001 WS — ver mosquitto.conf:4 listener 1883
# MQTT auth — vacío Sprint 1 (allow_anonymous true en mosquitto.conf:6, LAN cerrada)
# Futuro: genera con `mosquitto_passwd -c /mosquitto/config/passwd aethernet` y pon aquí (ver acl.conf)
MQTT_USERNAME=  # vacío LAN — como MQTT_USER "" en gateway secrets.h
MQTT_PASSWORD=  # vacío LAN — futuro: hash de passwd file

# --------------------------------------------------------------------------
# FastAPI — opcional, sobrescribe defaults de backend/app/config.py:11
# --------------------------------------------------------------------------
# API_HOST/PORT — si no defines, config.py usa 0.0.0.0:8000 (ver Dockerfile:17)
# En Docker, 0.0.0.0 es necesario para que host mapee puerto (como --host 0.0.0.0 en vite)
# API_HOST=0.0.0.0
# API_PORT=8000  # 8000 FastAPI — mismo que gateway BACKEND_PORT 8000 y Dockerfile EXPOSE 8000
