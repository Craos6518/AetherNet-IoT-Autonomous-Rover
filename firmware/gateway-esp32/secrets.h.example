// secrets.h.example — AetherNet Gateway ESP32
// Copia a secrets.h (no trackeado, .gitignore) y completa con tus valores LAN.
// NUNCA commitees secrets.h con credenciales reales — ver docs/auditoria-secretos-sprint1.md H-01.

#pragma once

// WiFi — debe ser 2.4GHz (ESP32 no soporta 5GHz)
#define WIFI_SSID "AetherNet-LAN"
#define WIFI_PASSWORD "your_wifi_password"

// MQTT broker (Mosquitto en LAN)
#define MQTT_BROKER "192.168.1.100"
#define MQTT_PORT 1883
#define MQTT_CLIENT_ID "gateway-esp32"
#define MQTT_USER ""
#define MQTT_PASS ""

// Backend HTTP — FastAPI en LAN (POST /api/access-events)
#define BACKEND_HOST "192.168.1.100"
#define BACKEND_PORT 8000
#define BACKEND_ACCESS_PATH "/api/access-events"
